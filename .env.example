# Used by `npm run dev` (frontend) and `npm run bootstrap-admin`.
# Copy to .env and fill in. Never commit .env.

# Supabase → Project Settings → API (or Data API) → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Only for the bootstrap script. Same Project URL as above.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → service_role (secret). Keep it private!
SUPABASE_SERVICE_ROLE_KEY=
# Your GitHub Pages address, e.g. https://your-user.github.io/secret-santa/
SITE_URL=https://YOUR-USER.github.io/secret-santa/
